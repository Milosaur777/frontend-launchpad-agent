# ═══════════════════════════════════════════════════════════════════════════════
# SOLANA WALLET
# ═══════════════════════════════════════════════════════════════════════════════
# Your base58-encoded Solana private key (from Phantom: Settings -> Export Private Key)
# WARNING: Keep this secret. Never commit it.
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# RPC ENDPOINTS
# ═══════════════════════════════════════════════════════════════════════════════
# Public Solana RPC (free, rate-limited)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Helius RPC (free tier: 100k requests/day)
# Sign up at https://helius.xyz and replace with your endpoint
HELIUS_RPC_URL=
HELIUS_API_KEY=

# Dexploit API key (free tier: unlimited requests, 20 RPS)
# Sign up at https://dexploit.dev/dashboard (free, no credit card)
DEEXPLOIT_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# TRADING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Trading mode: True = live, False = paper (no real trades)
LIVE_MODE=false

# Initial capital in USD
INITIAL_CAPITAL=100

# Maximum risk per trade (% of capital)
MAX_RISK_PER_TRADE=0.20

# ═══════════════════════════════════════════════════════════════════════════════
# DATA
# ═══════════════════════════════════════════════════════════════════════════════
# Directory for TradingView CSV files (for warm-start)
# Place CSVs in data/historical/ with format: *tokenname*.csv
# CSV columns: Time,Open,High,Low,Close,Volume
HISTORICAL_DATA_DIR=data/historical

# Maximum daily loss (% of capital)
MAX_DAILY_LOSS=0.10

# Maximum drawdown before halt (% of capital)
MAX_DRAWDOWN=0.30

# Stop loss per trade (%)
STOP_LOSS_PCT=0.05

# Take profit per trade (%)
TAKE_PROFIT_PCT=0.10

# Trailing stop-loss: trail the highest price by this % after activation
TRAILING_STOP_PCT=0.03

# Trailing stop activation: only enable once price is up this % from entry
TRAILING_STOP_ACTIVATION_PCT=0.05

# Maximum slippage per trade (basis points, 500 = 5%)
MAX_SLIPPAGE_BPS=500

# Jito tip amount (lamports, 10000 = 0.00001 SOL)
JITO_TIP_LAMPORTS=10000

# ═══════════════════════════════════════════════════════════════════════════════
# ML CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Minimum model confidence to trade (0.0 - 1.0)
MIN_CONFIDENCE=0.65

# ML retrain frequency (hours)
ML_RETRAIN_HOURS=24

# Lookback period for features (number of candles)
LOOKBACK_CANDLES=100

# Timeframe for analysis (1m, 5m, 15m, 1h)
TIMEFRAME=5m

# ═══════════════════════════════════════════════════════════════════════════════
# ASSET FILTERS — ESTABLISHED VIRAL MEMECOINS ONLY
# These filters intentionally ignore brand-new launches / PumpFun snipes.
# ═══════════════════════════════════════════════════════════════════════════════
MIN_LIQUIDITY_USD=50000
MIN_VOLUME_24H_USD=100000
MIN_TOKEN_AGE_HOURS=24
MAX_TOKEN_AGE_HOURS=720
MIN_TXNS_24H=500
MIN_BUY_RATIO=0.35
MAX_BUY_RATIO=0.75

# ═══════════════════════════════════════════════════════════════════════════════
# WATCHLIST MODE
# "discovery" = scan DexScreener for trending tokens
# "fixed"     = trade only the curated watchlist in config/settings.py
# ═══════════════════════════════════════════════════════════════════════════════
WATCHLIST_MODE=discovery

# ═══════════════════════════════════════════════════════════════════════════════
# BACKTEST CONFIG
# ═══════════════════════════════════════════════════════════════════════════════
BACKTEST_INITIAL_CAPITAL=100
BACKTEST_FEE_PCT=0.002

# ═══════════════════════════════════════════════════════════════════════════════
# NOTIFICATIONS (Optional)
# ═══════════════════════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

SLACK_WEBHOOK_URL=
